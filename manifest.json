{
  "name": "WriterForge",
  "version": "23.1.0",
  "phase": "verified-original-study-durable-xuehai",
  "principle": "actual source -> ordered study -> durable snapshot -> source-grounded local model generation -> explicit author acceptance; external critique read-only",
  "runtime": {
    "lanes": [
      "SYNC",
      "DRAFT",
      "REACTIVE",
      "BOUNDARY",
      "TRANSITION",
      "OFFLINE",
      "IDLE"
    ],
    "event_batching": true,
    "dirty_domain_routing": true,
    "min_heap_queue": true,
    "stale_transition_discard": true,
    "starvation_protection": true,
    "dependency_fingerprint": true,
    "singleflight": true,
    "idempotent_commit": true,
    "event_priority": [
      "DISCRETE",
      "CONTINUOUS",
      "DEFAULT",
      "IDLE"
    ],
    "lane_root_state": {
      "pending": true,
      "suspended": true,
      "pinged": true,
      "warm": true,
      "expired": true,
      "entangled": true
    },
    "transitive_entanglement": true,
    "source_priority_tiebreak": true,
    "story_work_tree": {
      "double_buffer": true,
      "child_lane_bubbling": true,
      "subtree_bailout": true,
      "begin_complete_phases": true,
      "durable_side_effects_in_render": false,
      "keyed_reorder_reconciliation": false
    },
    "hardening": {
      "lane_specific_pending_updates": true,
      "reject_cleanup": true,
      "speculative_graph_release": true,
      "bounded_reactive_cache": true,
      "inflight_invalidation_race_guard": true,
      "aggregated_event_batching": true,
      "queue_scope_cleanup": true,
      "suspended_entanglement_guard": true
    },
    "durable_transactional_commit": true,
    "story_effects": true,
    "durable_commit_receipts": true,
    "effect_journal": true,
    "worktree_commit_fingerprint": true,
    "main_write_commit_loop_closed": true,
    "restart_worktree_rehydration": "verified receipt-matched restore_work_root, no speculative state",
    "memory_safeguards": {
      "sqlite_page_cache_kib": 8192,
      "xuehai_candidate_cap": 512,
      "xuehai_return_cap": 32,
      "source_download_max_mib": 8,
      "max_study_units_per_chapter": 8000,
      "worktree_checkpoint_max_chars": 8000000,
      "worktree_checkpoint_max_nodes": 20000,
      "worktree_render_unit_cap": 20000,
      "event_batch_pending_scopes_cap": 4096,
      "lane_task_pending_cap": 4096,
      "history_queries_paginated": true
    }
  },
  "craft_engine": {
    "groups": [
      "dialogue_action",
      "perception_description",
      "cognitive_motion",
      "narrative_restraint",
      "scene_turn_rhythm"
    ],
    "max_active_groups_per_scene": 2
  },
  "anti_patterns": [
    "all skills always on",
    "all deep reviewers on every boundary",
    "alphabetical budget competition",
    "legacy event-object pooling",
    "global recompute after local change",
    "reviewer per sentence",
    "automatic prose humanizer",
    "AI self-feedback promoted to source evidence"
  ],
  "test_status": {
    "suite": "python -m unittest discover -s tests -q",
    "status": "verified CI on V23.1 PR",
    "note": "regressions test software behavior, not subjective literary quality"
  },
  "literary_study": {
    "first_book": "西遊記 (Project Gutenberg #23962), 100 original Chinese chapters",
    "source_trust": "original Chinese not translation",
    "mode": "sequential deterministic structural indexing",
    "deep_reader_first_training": false,
    "model_weight_finetuning": false,
    "reader_rating_performed": false,
    "source_artifact": "GitHub Actions 西遊記原著100回学习验收"
  },
  "reviewer": {
    "integration": "lit-critic localhost REST API",
    "report": "immutable per-session Markdown and JSON",
    "live_judgment_performed": false,
    "autonomous_story_rewrites": false
  },
  "writing": {
    "cli": true,
    "grounded_retrieval_required": true,
    "local_model_endpoint": "localhost",
    "actual_model_generation_in_ci": false,
    "author_approval_before_acceptance": true
  },
  "original_chinese_study": {
    "work_id": "xiyouji-gutenberg-23962",
    "source": "https://www.gutenberg.org/ebooks/23962",
    "chapters": 100,
    "analysis_depth": "deterministic_structural_unverified",
    "remote_store": "GitHub Release public-domain allowlist only",
    "release_tag_prefix": "xuehai-xiyouji-23962-s1-",
    "storage_schema": 1,
    "local_restore_command": "writerforge --db writerforge.sqlite3 restore-xiyouji",
    "true_model_fine_tune": false,
    "independent_litcritic_live_review": false
  }
}
