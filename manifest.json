{
  "name": "WriterForge",
  "version": "16.0",
  "phase": "event-priority-lane-root-runtime",
  "principle": "small event API, rich internal scheduler, tiny active literary route",
  "runtime": {
    "lanes": [
      "SYNC",
      "DRAFT",
      "REACTIVE",
      "BOUNDARY",
      "TRANSITION",
      "OFFLINE",
      "IDLE"
    ],
    "event_batching": true,
    "dirty_domain_routing": true,
    "min_heap_queue": true,
    "stale_transition_discard": true,
    "starvation_protection": true,
    "dependency_fingerprint": true,
    "singleflight": true,
    "idempotent_commit": true,
    "event_priority": [
      "DISCRETE",
      "CONTINUOUS",
      "DEFAULT",
      "IDLE"
    ],
    "lane_root_state": {
      "pending": true,
      "suspended": true,
      "pinged": true,
      "warm": true,
      "expired": true,
      "entangled": true
    },
    "transitive_entanglement": true,
    "source_priority_tiebreak": true
  },
  "craft_engine": {
    "groups": [
      "dialogue_action",
      "perception_description",
      "cognitive_motion",
      "narrative_restraint",
      "scene_turn_rhythm"
    ],
    "max_active_groups_per_scene": 2
  },
  "anti_patterns": [
    "all skills always on",
    "all deep reviewers on every boundary",
    "alphabetical budget competition",
    "legacy event-object pooling",
    "global recompute after local change",
    "reviewer per sentence",
    "automatic prose humanizer",
    "AI self-feedback promoted to source evidence"
  ],
  "test_status": {
    "suite": "python -m unittest discover -s tests -q",
    "passed": 107,
    "failed": 0,
    "status": "verified by GitHub CI on V16 PR"
  }
}
