{
  "name": "WriterForge",
  "version": "15.0",
  "phase": "lane-scheduled-reactive-novelist-runtime",
  "principle": "large capability library, tiny active route",
  "runtime": {
    "lanes": ["SYNC", "DRAFT", "REACTIVE", "BOUNDARY", "TRANSITION", "OFFLINE", "IDLE"],
    "event_batching": true,
    "dirty_domain_routing": true,
    "min_heap_queue": true,
    "stale_transition_discard": true,
    "starvation_protection": true,
    "dependency_fingerprint": true,
    "singleflight": true,
    "idempotent_commit": true
  },
  "craft_engine": {
    "groups": [
      "dialogue_action",
      "perception_description",
      "cognitive_motion",
      "narrative_restraint",
      "scene_turn_rhythm"
    ],
    "max_active_groups_per_scene": 2
  },
  "anti_patterns": [
    "all skills always on",
    "all deep reviewers on every boundary",
    "alphabetical budget competition",
    "legacy event-object pooling",
    "global recompute after local change",
    "reviewer per sentence",
    "automatic prose humanizer",
    "AI self-feedback promoted to source evidence"
  ],
  "test_status": {
    "suite": "python -m unittest discover -s tests -q",
    "status": "verified by GitHub CI on V15 branch before merge"
  }
}
